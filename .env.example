PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Email (canal notifications) ──────────────────────────────────────────────
# Origin du site pour les liens profonds des emails.
PUBLIC_SITE_URL=http://localhost:5173
# Dev/test : SMTP local (Mailpit sur l'instance Supabase locale).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
EMAIL_FROM=noreply@betwithfriend.app
EMAIL_FROM_NAME=Bet With Friend
# Prod : définir RESEND_API_KEY pour basculer sur Resend (+ EMAIL_FROM sur
# un domaine vérifié par Resend).
